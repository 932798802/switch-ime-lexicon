# ============================================================================
#  ns-ime —— .gitignore
#
#  原则：**绝不让以下内容进入版本库**（它们来自主机备份，或含第三方版权材料）
#    ① 主机密钥          —— 最高敏感，公网严禁
#    ② 原版固件词典      —— 任天堂版权内容
#    ③ 生成产物          —— 内含并入的原版条目，属衍生版权内容
#    ④ 编译产物/中间件
#    ⑤ 本地缓存 / 备份
#    ⑥ 敏感词库          —— 含政治/色情等敏感内容，公网严禁#
#  这些文件由使用者自备（用**自己的**主机备份解包），不入库、不分发。
# ============================================================================

# ---------- ① 主机密钥（最高敏感）----------
*.keys
prod.keys
*.key

# ---------- ② 原版固件词典（任天堂版权内容）----------
# 从使用者的主机备份解包得到，不随仓库分发
01_Inputs/firmware/dat0805/
01_Inputs/firmware/dat0808/
*.nca
*.nsp
*.xci
*.kip
*.kip1
*.hdr

# ---------- ②b 敏感词库（含政治/色情/暴恐等内容，不入库）----------
# 来源：Konsheng/Sensitive-lexicon（MIT）。使用者自行 clone 到该目录；
# 也可只用 01_Inputs/sensitive/whitelist.txt 做本地豁免。
01_Inputs/sensitive/

# ---------- ③ 生成产物（并入原版条目 → 任天堂衍生版权内容）----------
# 产物 .a = 我们的词 + **并入的原版词典条目**，属第三方版权衍生内容，
# 公网仓库严禁分发。2026-10-08 恢复屏蔽，并已从 git 历史中剔除。
#   目录形态：04_Outputs/<版本>/atmosphere/.../pinyin/{GB18030,GB2312}/njubase3.a
#   必须用 ** 匹配任意深度（旧规则 04_Outputs/*.a 只匹配一层，会漏网 —— 踩过）
# 产物由使用者自行生成：跑 05_Code/tools/{mk_lexicon,build_from_lexicon}.py
04_Outputs/**/*.a

# ---------- ④ 编译产物与中间文件 ----------
*.o
*.d
*.exe

# ---------- ⑤ 本地缓存 / 备份 / 归档 ----------
10_Other/

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
