# ============================================================================
#  ns-ime —— .gitignore
#
#  原则：**绝不让以下内容进入版本库**（它们来自主机备份，或含第三方版权材料）
#    ① 主机密钥          —— 最高敏感，公网严禁
#    ② 原版固件词典      —— 任天堂版权内容
#    ③ 生成产物          —— 内含并入的原版条目，属衍生版权内容
#    ④ 编译产物/中间件
#    ⑤ 本地缓存 / 备份
#
#  这些文件由使用者自备（用**自己的**主机备份解包），不入库、不分发。
# ============================================================================

# ---------- ① 主机密钥（最高敏感）----------
*.keys
prod.keys
*.key

# ---------- ② 原版固件词典（任天堂版权内容）----------
# 从使用者的主机备份解包得到，不随仓库分发
01_Inputs/firmware/dat0805/
01_Inputs/firmware/dat0808/
*.nca
*.nsp
*.xci
*.kip
*.kip1
*.hdr

# ---------- ③ 生成产物（并入原版条目 → 衍生版权内容）----------
# 产物现在铺在 04_Outputs/<v版本>/atmosphere/... 下，必须用 ** 匹配任意深度
04_Outputs/**/*.a
05_Code/nro/assets/*.a

# ---------- ④ 编译产物与自动生成的中间文件 ----------
05_Code/nro/build/
05_Code/nro/*.nro
05_Code/nro/*.elf
05_Code/nro/*.nacp
05_Code/nro/source/embed.s
05_Code/nro/source/embed_meta.h
05_Code/nro/tools/host_test.exe
*.o
*.d
*.exe

# ---------- ⑤ 本地缓存 / 备份 / 归档 ----------
10_Other/

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
